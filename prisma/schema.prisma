datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String   // Arabic Name (Default)
  nameEn        String?  // English Name
  price         Float
  imagePath     String
  description   String?  // Arabic Description
  descriptionEn String?  // English Description
  createdAt     DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Customer {
  id          Int      @id @default(autoincrement())
  phone       String   @unique
  name        String
  password    String
  address     String?
  orders      Order[]
  createdAt   DateTime @default(now())
}

model Order {
  id            Int      @id @default(autoincrement())
  customerName  String
  customerPhone String   @default("")
  address       String   @default("")
  latitude      Float?
  longitude     Float?
  deliveryDate  String?
  deliveryTime  String?
  items         String   @default("[]") // JSON string of items
  total         Float
  status        String   @default("new") // new, processing, completed, cancelled
  paymentMethod String   @default("cash") // cash, transfer
  details       String?  // Optional extra notes
  createdAt     DateTime @default(now())
  
  customerId    Int?
  customer      Customer? @relation(fields: [customerId], references: [id])
}

model Gallery {
  id        Int      @id @default(autoincrement())
  imagePath String
  title     String?
  createdAt DateTime @default(now())
}

model Staff {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  name        String
  role        String   @default("staff") // admin, manager, staff
  permissions String   @default("[]") // JSON array: ["orders","products","gallery","customers","reports","settings"]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}
